// Prisma schema — Yellow
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Role of a user within a tenant (multi-tenant RBAC base).
enum Role {
  OWNER
  ADMIN
  MEMBER
}

/// Lifecycle of an emitted DTE: draft → signed → sent → accepted/rejected.
enum DteEstado {
  BORRADOR
  FIRMADO
  ENVIADO
  ACEPTADO
  RECHAZADO
  ANULADO
}

/// SALIDA = emitted by the tenant (sales). ENTRADA = received from a
/// third party (purchases, downloaded from the SII once certified).
enum DteSentido {
  SALIDA
  ENTRADA
}

/// Tenant — root of multi-tenant isolation. Every business record
/// must reference a tenantId to keep data partitioned per tenant.
model Tenant {
  id        String         @id @default(cuid())
  name      String
  slug      String         @unique
  /// Chilean company tax identifier (RUT), when applicable.
  rut       String?        @unique
  // ── Emisor SII profile (nullable until the company is registered) ──
  razonSocial        String?
  giro                String?
  /// Economic activity code (ACTEco) assigned by the SII.
  actividadEconomica String?
  direccion           String?
  comuna              String?
  emailSii            String?
  /// Resolución SII that authorized electronic emission (EnvioDTE carátula).
  resolucionFecha     DateTime?
  resolucionNumero    Int?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  members   TenantMember[]
  sessions  Session[]
  invitations Invitation[]
  cafs         Caf[]
  dteDocuments DteDocument[]
  vendedores   Vendedor[]
  centrosCosto CentroCosto[]
  categorias   Categoria[]
  siiCertificates SiiCertificate[]
}

/// SII digital certificate (.p12/.pfx) for the tenant's emisor.
/// The PKCS#12 blob and its password are stored AES-256-GCM encrypted
/// (src/lib/crypto.ts); the API only ever returns the metadata columns.
/// The single `active` certificate drives real signing + upload.
model SiiCertificate {
  id        String  @id @default(cuid())
  tenantId  String
  /// Friendly label ("Certificado emisor 2026").
  nombre    String
  /// Encrypted envelope containing the base64 PKCS#12 bytes.
  p12Encrypted String
  /// Encrypted envelope containing the PKCS#12 password.
  passwordEncrypted String
  /// Subject summary extracted at upload ("CN=..., O=...").
  subject   String?
  /// RUT parsed from the certificate subject, when present.
  rut       String?
  issuer    String?
  serialNumber String?
  notBefore DateTime?
  notAfter  DateTime?
  /// Exactly one active certificate per tenant (enforced by the API).
  active    Boolean @default(true)
  createdAt DateTime @default(now())
  tenant    Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, active])
}

/// Salesperson catalog (commercial entity, not a system user):
/// one tenant's sellers do not need a Yellow account.
model Vendedor {
  id        String   @id @default(cuid())
  tenantId  String
  nombre    String
  email     String?
  /// Inactive sellers stop appearing in forms but keep historical docs.
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  documentos DteDocument[]

  @@index([tenantId, activo])
}

/// Cost center, assigned at document level (one invoice = one center).
model CentroCosto {
  id        String   @id @default(cuid())
  tenantId  String
  /// Short code (e.g. "ADM", "VENTAS"), unique per tenant.
  codigo    String
  nombre    String
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  documentos DteDocument[]

  @@unique([tenantId, codigo])
  @@index([tenantId, activo])
}

/// Line-item category: product/service on sales, expense type on purchases.
model Categoria {
  id        String   @id @default(cuid())
  tenantId  String
  nombre    String
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  items     DteItem[]

  @@unique([tenantId, nombre])
  @@index([tenantId, activo])
}

/// CAF — folio authorization granted by the SII per document type.
/// Contains the RSA private key (RSASK) used to stamp the TED, so the
/// XML must be handled as a secret (never logged or sent to clients).
model Caf {
  id         String   @id @default(cuid())
  tenantId   String
  /// Document type this CAF authorizes (33, 34, 52, 46, 56, 61…).
  tipoDte    Int
  folioDesde Int
  folioHasta Int
  /// Next folio to allocate; advanced atomically when emitting.
  nextFolio  Int
  /// Full CAF XML exactly as downloaded from the SII (sensitive).
  xml        String
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, tipoDte])
}

/// Documento Tributario Electrónico (emitted or received).
/// All monetary amounts are integer Chilean pesos (CLP).
model DteDocument {
  id           String     @id @default(cuid())
  tenantId     String
  sentido      DteSentido @default(SALIDA)
  /// SII document type: 33/34 facturas, 52 guía, 46 factura de compra, 56 ND, 61 NC.
  tipoDte      Int
  /// Assigned from the tenant's CAF at emission time.
  folio        Int?
  fechaEmision DateTime   @default(now())
  // ── Receptor (SALIDA: the customer; null on ENTRADA docs) ──
  receptorRut          String?
  receptorRazonSocial  String?
  receptorGiro         String?
  receptorDireccion    String?
  receptorComuna       String?
  receptorEmail        String?
  // ── Emisor/proveedor (ENTRADA: the third-party issuer; null on SALIDA) ──
  emisorRut          String?
  emisorRazonSocial  String?
  emisorGiro         String?
  // ── Commercial dimensions ──
  vendedorId   String?
  costCenterId String?
  vendedor   Vendedor?   @relation(fields: [vendedorId], references: [id], onDelete: SetNull)
  costCenter CentroCosto? @relation(fields: [costCenterId], references: [id], onDelete: SetNull)
  // ── Guía de despacho (52) ──
  tipoTraslado Int?
  motivoTraslado String?
  // ── Totales (CLP enteros; IVA 19% redondeado) ──
  neto   Int @default(0)
  mntExe Int @default(0)
  iva    Int @default(0)
  total  Int @default(0)
  // ── Estado de envío al SII ──
  estado      DteEstado @default(BORRADOR)
  trackId     String?
  siiResponse String?
  /// Cómo se anuló (NC/ND emitida, folio anulado o carta al SII) + motivo.
  motivoAnulacion String?
  /// Signed DTE XML (only persisted once the document is FIRMADO+).
  xml         String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  items       DteItem[]
  references  DteReference[]

  @@index([tenantId, tipoDte, fechaEmision])
  @@index([tenantId, estado])
  @@index([tenantId, sentido, fechaEmision])
  @@index([tenantId, vendedorId])
  @@index([tenantId, costCenterId])
}

/// Line item of a DTE. total = round(cantidad × precio) − descuento.
model DteItem {
  id             String   @id @default(cuid())
  documentId     String
  linea          Int
  nombre         String
  /// Quantity (decimals allowed: kg, hours, units).
  cantidad       Decimal  @default(1) @db.Decimal(14, 3)
  /// Unit price in CLP (integer pesos).
  precioUnitario Int
  /// Line discount in CLP.
  descuento      Int      @default(0)
  /// false → exempt from IVA (counts toward MntExe).
  afectoIva      Boolean  @default(true)
  /// Computed server-side from cantidad × precio − descuento.
  total          Int
  /// Product/service (sales) or expense type (purchases).
  categoryId String?
  categoria  Categoria? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  document       DteDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@index([categoryId])
}

/// Reference to another DTE (required for notas de crédito/débito and
/// informative for guías de despacho).
model DteReference {
  id         String   @id @default(cuid())
  documentId String
  /// Type of the referenced document (33, 34, 46…).
  tipoDteRef Int
  folioRef   Int
  fechaRef   DateTime?
  /// SII código: 1 = anula, 2 = corrige texto, 3 = corrige montos.
  codigoRef  Int?
  motivo     String?
  document   DteDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
}

/// Application user (global). Access to tenants is granted
/// through TenantMember — a user can belong to several tenants.
model User {
  id           String         @id @default(cuid())
  email        String         @unique
  name         String?
  /// Hashed password (scrypt). Never store plaintext credentials.
  passwordHash String
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  members      TenantMember[]
  sessions     Session[]
  invitations  Invitation[]
}

/// Invitation to join a tenant with a given role. The raw token is
/// returned once to the inviter; only its SHA-256 hash is stored.
model Invitation {
  id          String    @id @default(cuid())
  tenantId    String
  /// Normalized (lowercase) email of the invitee.
  email       String
  /// OWNER transfer is out of scope: invitations grant ADMIN or MEMBER.
  role        Role      @default(MEMBER)
  tokenHash   String    @unique
  invitedById String?
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime  @default(now())
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invitedBy   User?     @relation(fields: [invitedById], references: [id], onDelete: SetNull)

  @@unique([tenantId, email])
  @@index([tenantId])
}

/// Server-side session. The cookie carries a random token; only its
/// SHA-256 hash is stored, so a DB leak does not expose live sessions.
model Session {
  id             String   @id @default(cuid())
  tokenHash      String   @unique
  userId         String
  activeTenantId String?
  expiresAt      DateTime
  createdAt      DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeTenant   Tenant?  @relation(fields: [activeTenantId], references: [id], onDelete: SetNull)

  @@index([userId])
}

/// Join table: user ↔ tenant with an RBAC role.
model TenantMember {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String
  role      Role     @default(MEMBER)
  createdAt DateTime @default(now())
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([tenantId])
  @@index([userId])
}
