// Prisma schema — Yellow
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Role of a user within a tenant (multi-tenant RBAC base).
enum Role {
  OWNER
  ADMIN
  MEMBER
}

/// Tenant — root of multi-tenant isolation. Every business record
/// must reference a tenantId to keep data partitioned per tenant.
model Tenant {
  id        String         @id @default(cuid())
  name      String
  slug      String         @unique
  /// Chilean company tax identifier (RUT), when applicable.
  rut       String?        @unique
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  members   TenantMember[]
  sessions  Session[]
  invitations Invitation[]
}

/// Application user (global). Access to tenants is granted
/// through TenantMember — a user can belong to several tenants.
model User {
  id           String         @id @default(cuid())
  email        String         @unique
  name         String?
  /// Hashed password (scrypt). Never store plaintext credentials.
  passwordHash String
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  members      TenantMember[]
  sessions     Session[]
  invitations  Invitation[]
}

/// Invitation to join a tenant with a given role. The raw token is
/// returned once to the inviter; only its SHA-256 hash is stored.
model Invitation {
  id          String    @id @default(cuid())
  tenantId    String
  /// Normalized (lowercase) email of the invitee.
  email       String
  /// OWNER transfer is out of scope: invitations grant ADMIN or MEMBER.
  role        Role      @default(MEMBER)
  tokenHash   String    @unique
  invitedById String?
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime  @default(now())
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invitedBy   User?     @relation(fields: [invitedById], references: [id], onDelete: SetNull)

  @@unique([tenantId, email])
  @@index([tenantId])
}

/// Server-side session. The cookie carries a random token; only its
/// SHA-256 hash is stored, so a DB leak does not expose live sessions.
model Session {
  id             String   @id @default(cuid())
  tokenHash      String   @unique
  userId         String
  activeTenantId String?
  expiresAt      DateTime
  createdAt      DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeTenant   Tenant?  @relation(fields: [activeTenantId], references: [id], onDelete: SetNull)

  @@index([userId])
}

/// Join table: user ↔ tenant with an RBAC role.
model TenantMember {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String
  role      Role     @default(MEMBER)
  createdAt DateTime @default(now())
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([tenantId])
  @@index([userId])
}
