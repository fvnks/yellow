# Copy to .env and fill in real values. Never commit .env.

# Database (Prisma)
DATABASE_URL="postgresql://user:password@localhost:5432/yellow"

# Optional: 32-byte key in hex used to encrypt .p12 certificates
# (AES-256-GCM). If absent, the key derives from DATABASE_URL.
CERT_ENCRYPTION_KEY=

# Optional: SII environment. "certificacion" (default, maullin.sii.cl)
# or "produccion" (palena.sii.cl). Only relevant with an active .p12.
SII_ENV=certificacion
